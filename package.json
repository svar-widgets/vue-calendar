{
	"name": "@svar-ui/vue-calendar",
	"version": "2.7.0",
	"description": "SVAR Vue Calendar library",
	"productTag": "calendar",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:demo": "BUILD_DEMOS=true vite build",
		"build:full-css": "BUILD_FULL_CSS=true vite build",
		"lint": "eslint . --report-unused-disable-directives",
		"preview": "vite preview",
		"prepare": "husky",
		"prettier": "prettier --write ./src/ ./demos/"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.es.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.es.js"
		},
		"./style.css": "./dist/index.css",
		"./all.css": "./dist-full/index.css"
	},
	"types": "./types/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"files": [
		"dist",
		"types",
		"package.json",
		"dist-full/index.css"
	],
	"dependencies": {
		"@svar-ui/calendar-ical": "2.7.0",
		"@svar-ui/calendar-locales": "2.7.0",
		"@svar-ui/calendar-provider": "2.7.0",
		"@svar-ui/calendar-store": "2.7.0",
		"@svar-ui/core-locales": "2.6.1",
		"@svar-ui/lib-dom": "0.14.0",
		"@svar-ui/lib-vue": "1.1.0",
		"@svar-ui/lib-state": "1.9.7",
		"@svar-ui/vue-core": "2.6.1",
		"@svar-ui/vue-editor": "2.7.0",
		"@svar-ui/vue-menu": "2.6.1",
		"@svar-ui/vue-toolbar": "2.6.1"
	},
	"peerDependencies": {
		"vue": "^3.0.0"
	},
	"devDependencies": {
		"@svar-ui/vue-comments": "2.6.0",
		"@svar-ui/vue-excel-import": "2.6.0",
		"@svar-ui/vue-export-popup": "2.6.0",
		"@svar-ui/vue-filter": "2.6.0",
		"@svar-ui/vue-layout": "2.6.0",
		"@svar-ui/vue-tasklist": "2.6.0",
		"@vitejs/plugin-vue": "^6.0.1",
		"eslint": "^9.35.0",
		"eslint-plugin-vue": "^10.5.1",
		"globals": "^16.5.0",
		"husky": "9.1.6",
		"lint-staged": "15.2.10",
		"prettier": "3.3.3",
		"vite": "^7.2.2",
		"vue-router": "^4.6.3",
		"xlsx-writer-lite": "0.3.0"
	},
	"homepage": "https://svar.dev/vue/calendar/",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/vue-calendar.git"
	},
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"publishConfig": {
		"access": "public"
	},
	"lint-staged": {
		"*.{ts,js,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,md,json}": [
			"prettier --write"
		]
	},
	"packageManager": "npm@12.0.2"
}
